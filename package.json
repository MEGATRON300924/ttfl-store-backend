{
  "name": "ttfl-store-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "node scripts/ensure-affiliate-prisma-schema.cjs && node scripts/ensure-tracking-schema.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:safe-push": "node scripts/safe-prisma-push.cjs",
    "prisma:studio": "prisma studio",
    "seed:admin": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "test:email": "tsx scripts/test-email.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "argon2": "^0.40.3",
    "cloudinary": "^2.10.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "resend": "^6.22.1",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.19.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.19.0",
    "typescript": "5.5.4"
  }
}
