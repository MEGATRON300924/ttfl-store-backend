# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (Render PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:5432/ttfl_store?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Cookies
COOKIE_DOMAIN=""
COOKIE_CROSS_SITE=false

# CORS
CORS_ORIGIN="http://localhost:3000"

# Google Sign-In
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email — EMAIL_PROVIDER controls which adapter lib/email-adapter.ts uses.
# "resend" = production (recommended, requires RESEND_API_KEY below).
# "smtp"   = secondary option (requires the SMTP vars further down).
# "console" = local dev default — just logs instead of sending anything.
EMAIL_FROM="TTFL Store <notifications@mail.ttflstore.name.ng>"
EMAIL_PROVIDER="resend"

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# Paystack (spec §20)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Admin notifications (Phase 2)
ADMIN_NOTIFICATION_EMAIL="admin@thetronforge.com"

# Resend (production email provider) — https://resend.com
# Get this from your Resend dashboard. Never commit the real value.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMTP — only needed if EMAIL_PROVIDER=smtp instead of resend. Not the
# production default; kept as a secondary option.
EMAIL_HOST="smtp.your-provider.com"
EMAIL_PORT=587
EMAIL_USER="apikey-or-username"
EMAIL_PASSWORD="your-smtp-password"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_NUMBER=""
BOTPRESS_WHATSAPP_WEBHOOK_URL=""
BOTPRESS_WHATSAPP_WEBHOOK_SECRET=""

# Approved WhatsApp template configuration. Template names must exactly
# match approved templates in Meta WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION="ttfl_order_confirmation"
WHATSAPP_TEMPLATE_ADMIN_NEW_ORDER="ttfl_admin_order_alert"
WHATSAPP_TEMPLATE_VENDOR_APPLICATION="ttfl_vendor_application"
WHATSAPP_TEMPLATE_PAYMENT_ALERT="ttfl_payment_alert"
WHATSAPP_TEMPLATE_GENERIC_NOTIFICATION="ttfl_notification"

# Cloudinary (image uploads) — required for vendor product image upload to work
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
