# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (Render PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:5432/ttfl_store?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Cookies
COOKIE_DOMAIN=""
COOKIE_CROSS_SITE=false

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (provider-agnostic — wire up an SMTP/API adapter later)
EMAIL_FROM="TTFL Store <no-reply@thetronforge.com>"
EMAIL_PROVIDER="console"

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# Paystack (spec §20)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Admin notifications (Phase 2)
ADMIN_NOTIFICATION_EMAIL="admin@thetronforge.com"

# SMTP email delivery — leave EMAIL_PROVIDER=console to just log emails
# instead of sending them (useful for local dev without a real provider)
EMAIL_HOST="smtp.your-provider.com"
EMAIL_PORT=587
EMAIL_USER="apikey-or-username"
EMAIL_PASSWORD="your-smtp-password"

# WhatsApp Business Cloud API (Meta) — leave unset to just log instead of
# sending; the customer-facing "Chat on WhatsApp" button works without this,
# this is only for admin/vendor push notifications
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_NUMBER=""

# Cloudinary (image uploads) — required for vendor product image upload to work
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
