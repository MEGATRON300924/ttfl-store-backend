# Render sets NODE_ENV=production by default for Node web services, and
# npm's default behavior under NODE_ENV=production is to skip
# devDependencies entirely during `npm install`. That silently strips out
# typescript, tsc-alias, prisma CLI, and every @types/* package this
# project's build genuinely needs (they're devDependencies because
# they're build-time only, not because they're optional).
#
# This line forces npm to always install devDependencies regardless of
# NODE_ENV, on every environment (Render, local, CI) — matching what
# `npm run build` on Render actually requires to succeed.
include=dev
