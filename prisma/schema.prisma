// TTFL Store — Database schema (Phase 1: identity & access)
// Covers spec §7 (database), §8 (auth), §9 (user types), §13 (vendor store
// shell), §17 (vendor tiers — enum only for now), §36 (audit logs).
// Orders, products, payments, commissions etc. are deliberately out of
// scope for this pass and will extend this same schema additively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum AuditAction {
  ADMIN_LOGIN
  USER_SUSPENDED
  USER_REACTIVATED
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  VENDOR_TIER_CHANGED
  VENDOR_PROFILE_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  ACCOUNT_DELETED
  PRODUCT_SUSPENDED
  PRODUCT_REINSTATED
  PRODUCT_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  VENDOR_PLAN_CREATED
  VENDOR_PLAN_UPDATED
  SUBSCRIPTION_CHANGED
  FEATURED_PRODUCT_APPROVED
  FEATURED_PRODUCT_CANCELLED
  FEATURED_STORE_APPROVED
  FEATURED_STORE_CANCELLED
  REVIEW_HIDDEN
  REVIEW_DELETED
  COUPON_CREATED
  COUPON_UPDATED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
  ORDER_REFUNDED
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OUT_OF_STOCK
}

// Spec §14 — the three selling methods a vendor can choose per product.
enum SellingMethod {
  CHECKOUT
  EXTERNAL_LINK
  WHATSAPP
}

// Spec §14/§15 — referral events recorded before redirecting off-platform.
enum ReferralType {
  EXTERNAL_CLICK
  WHATSAPP_CLICK
}

// Spec §21 — sub-order fulfillment lifecycle (per vendor).
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  FAILED
}

// Payment status on the parent (customer-facing) order.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// --- Phase 2 enums -----------------------------------------------------

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum FeaturedPlacement {
  HOMEPAGE
  CATEGORY
  SEARCH
  TRENDING
}

enum FeaturedStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  REPORTED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SupportConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum SupportSender {
  CUSTOMER
  AGENT
  SYSTEM
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)

  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions                 Session[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  vendorProfile            VendorProfile?
  addresses                Address[]
  auditLogsAsActor         AuditLog[] @relation("AuditActor")
  orders                   Order[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
  supportConversations     SupportConversation[]
  supportMessages          SupportMessage[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Sessions & tokens
// ---------------------------------------------------------------------------

model Session {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String  @unique
  userAgent       String?
  ipAddress       String?
  deviceLabel     String?

  revoked         Boolean  @default(false)
  revokedAt       DateTime?
  expiresAt       DateTime

  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Vendor & store
// ---------------------------------------------------------------------------

model VendorProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName      String
  storeSlug      String       @unique
  bio            String?
  location       String?
  whatsappNumber String?

  // Store branding
  logoUrl        String?
  logoPublicId   String?
  bannerUrl      String?
  bannerPublicId String?

  status         VendorStatus @default(PENDING)
  tier           VendorTier   @default(FREE)
  verified       Boolean      @default(false)

  // Overrides the tier's default commission % when set.
  // Null means "use the tier default".
  commissionRateOverride Decimal? @db.Decimal(5, 2)

  // Store page view counter.
  viewCount      Int          @default(0)

  appliedAt       DateTime     @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products          Product[]
  referralEvents    ReferralEvent[]
  vendorOrders      VendorOrder[]
  commissionRules   CommissionRule[]
  subscription      VendorSubscription?
  featuredProducts  FeaturedProduct[]
  featuredStores    FeaturedStore[]
  coupons           Coupon[]
  payouts           Payout[]

  @@index([status])
  @@index([tier])
  @@map("vendor_profiles")
}

// ---------------------------------------------------------------------------
// Catalog: categories & products
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?

  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")

  products  Product[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String         @id @default(uuid())
  vendorId      String
  vendor        VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])

  name          String
  slug          String         @unique
  description   String
  specifications Json?

  price         Decimal        @db.Decimal(12, 2)
  previousPrice Decimal?       @db.Decimal(12, 2)
  currency      String         @default("NGN")

  condition     ProductCondition @default(NEW)
  stock         Int             @default(0)
  status        ProductStatus    @default(ACTIVE)

  sellingMethod String? 
  externalUrl   String?
  whatsappNumber String?

  location      String?
  viewCount     Int             @default(0)

  avgRating     Decimal?        @db.Decimal(3, 2)
  reviewCount   Int             @default(0)

  images          ProductImage[]
  referralEvents  ReferralEvent[]
  reviews         Review[]
  wishlistedBy    WishlistItem[]
  featuredEntries FeaturedProduct[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([sellingMethod])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  position  Int      @default(0)
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Referral tracking
// ---------------------------------------------------------------------------

model ReferralEvent {
  id          String        @id @default(uuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        ReferralType
  sessionId   String?
  source      String?
  campaign    String?
  destination String?
  userAgent   String?
  deviceType  String?
  ipAddress   String?

  createdAt   DateTime      @default(now())

  @@index([vendorId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("referral_events")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     AuditAction
  targetType String?
  targetId   String?
  metadata   Json?

  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique

  customerId       String
  customer         User          @relation(fields: [customerId], references: [id])

  totalAmount      Decimal       @db.Decimal(12, 2)
  subtotalAmount   Decimal?      @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  couponCode       String?
  currency         String        @default("NGN")

  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String        @unique
  paidAt           DateTime?

  deliveryName     String
  deliveryPhone    String
  deliveryLine1    String
  deliveryLine2    String?
  deliveryCity     String
  deliveryState    String
  deliveryCountry  String        @default("Nigeria")

  vendorOrders     VendorOrder[]
  payments         Payment[]
  couponRedemption CouponRedemption?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId])
  @@index([paymentStatus])
  @@map("orders")
}

model VendorOrder {
  id                String        @id @default(uuid())

  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId          String
  vendor            VendorProfile @relation(fields: [vendorId], references: [id])

  status            OrderStatus   @default(PENDING)

  subtotal          Decimal       @db.Decimal(12, 2)
  commissionRate    Decimal       @db.Decimal(5, 2)
  commissionAmount  Decimal       @db.Decimal(12, 2)
  vendorEarnings    Decimal       @db.Decimal(12, 2)

  payoutStatus      String        @default("PENDING")
  payoutAt          DateTime?

  deliveryMethod    String?
  deliveryFee       Decimal       @default(0) @db.Decimal(12, 2)
  deliveryProvider  String?
  trackingNumber    String?
  trackingUrl       String?
  estimatedDeliveryAt DateTime?

  items             OrderItem[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_orders")
}

model OrderItem {
  id            String       @id @default(uuid())

  vendorOrderId String
  vendorOrder   VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  productId     String
  productName   String
  unitPrice     Decimal      @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal      @db.Decimal(12, 2)

  createdAt     DateTime     @default(now())

  @@index([vendorOrderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reference       String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  channel         String?
  gatewayResponse Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

model CommissionRule {
  id         String         @id @default(uuid())

  vendorId   String?
  vendor     VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String?

  type       CommissionType @default(PERCENTAGE)
  value      Decimal         @db.Decimal(12, 2)

  active     Boolean         @default(true)

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@map("commission_rules")
}

// ---------------------------------------------------------------------------
// Vendor plans & subscriptions
// ---------------------------------------------------------------------------

model VendorPlan {
  id             String        @id @default(uuid())
  tier           VendorTier    @unique
  name           String
  price          Decimal       @db.Decimal(12, 2)
  billingPeriod  BillingPeriod @default(MONTHLY)

  productLimit   Int?
  commissionRate Decimal       @db.Decimal(5, 2)
  features       Json?

  active         Boolean       @default(true)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscriptions  VendorSubscription[]

  @@map("vendor_plans")
}

model VendorSubscription {
  id              String             @id @default(uuid())

  vendorId        String             @unique
  vendor          VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  planId          String
  plan            VendorPlan         @relation(fields: [planId], references: [id])

  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now())
  renewalDate     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments        SubscriptionPayment[]

  @@index([status])
  @@map("vendor_subscriptions")
}

model SubscriptionPayment {
  id              String             @id @default(uuid())

  subscriptionId  String
  subscription    VendorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  reference       String             @unique
  amount          Decimal            @db.Decimal(12, 2)
  status          PaymentStatus      @default(PENDING)
  gatewayResponse Json?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Featured products & stores
// ---------------------------------------------------------------------------

model FeaturedProduct {
  id               String            @id @default(uuid())

  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  vendorId         String
  vendor           VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  placement        FeaturedPlacement
  durationDays     Int
  price            Decimal           @db.Decimal(12, 2)

  paymentReference String?           @unique
  status           FeaturedStatus    @default(PENDING_PAYMENT)

  startDate        DateTime?
  endDate          DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId])
  @@index([vendorId])
  @@index([status])
  @@index([placement])
  @@map("featured_products")
}

model FeaturedStore {
  id               String         @id @default(uuid())

  vendorId         String
  vendor           VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  durationDays     Int
  price            Decimal        @db.Decimal(12, 2)

  paymentReference String?        @unique
  status           FeaturedStatus @default(PENDING_PAYMENT)

  startDate        DateTime?
  endDate          DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("featured_stores")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id          String       @id @default(uuid())

  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId  String
  customer    User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderItemId String       @unique

  rating      Int
  comment     String?
  images      String[]     @default([])

  status      ReviewStatus @default(VISIBLE)
  reportCount Int          @default(0)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Coupons & promotions
// ---------------------------------------------------------------------------

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique

  type              CouponType
  value             Decimal   @db.Decimal(12, 2)

  vendorId          String?
  vendor            VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId        String?

  minOrderAmount    Decimal?  @db.Decimal(12, 2)
  maxDiscountAmount Decimal?  @db.Decimal(12, 2)

  usageLimit        Int?
  usageLimitPerUser Int       @default(1)
  firstOrderOnly    Boolean   @default(false)

  startsAt          DateTime?
  expiresAt         DateTime?
  active            Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  redemptions       CouponRedemption[]

  @@index([vendorId])
  @@index([active])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())

  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId         String
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Vendor payouts
// ---------------------------------------------------------------------------

model Payout {
  id            String        @id @default(uuid())

  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  status        PayoutStatus  @default(PENDING)

  vendorOrderIds String[]

  requestedAt   DateTime      @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  paidAt        DateTime?
  note          String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Email delivery log
// ---------------------------------------------------------------------------

model EmailLog {
  id         String      @id @default(uuid())

  to         String
  subject    String
  body       String
  event      String
  status     EmailStatus @default(PENDING)
  attempts   Int         @default(0)
  lastError  String?
  sentAt     DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([event])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Live support
// ---------------------------------------------------------------------------

model SupportConversation {
  id              String                    @id @default(uuid())

  customerId      String
  customer        User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderNumber     String?
  status          SupportConversationStatus @default(OPEN)
  assignedAdminId String?

  messages        SupportMessage[]

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid())

  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String?
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType     SupportSender

  body           String

  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Platform settings
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
