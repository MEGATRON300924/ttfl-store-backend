// TTFL Store — Database schema
// Phase 1 + Phase 2: identity, access, vendors, catalog, commerce,
// subscriptions, promotions, payouts, email delivery, support, and settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum AuditAction {
  ADMIN_LOGIN
  USER_SUSPENDED
  USER_REACTIVATED
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  VENDOR_TIER_CHANGED
  VENDOR_PROFILE_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  ACCOUNT_DELETED
  PRODUCT_SUSPENDED
  PRODUCT_REINSTATED
  PRODUCT_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  VENDOR_PLAN_CREATED
  VENDOR_PLAN_UPDATED
  SUBSCRIPTION_CHANGED
  FEATURED_PRODUCT_APPROVED
  FEATURED_PRODUCT_CANCELLED
  FEATURED_STORE_APPROVED
  FEATURED_STORE_CANCELLED
  REVIEW_HIDDEN
  REVIEW_DELETED
  COUPON_CREATED
  COUPON_UPDATED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
  ORDER_REFUNDED
  VENDOR_STAFF_INVITED
  VENDOR_STAFF_UPDATED
  VENDOR_STAFF_REMOVED
  VENDOR_STAFF_ACCEPTED
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OUT_OF_STOCK
}

// Spec §14 — the three selling methods a vendor can choose per product.
enum SellingMethod {
  CHECKOUT
  EXTERNAL_LINK
  WHATSAPP
}

// Spec §14/§15 — referral events recorded before redirecting off-platform.
enum ReferralType {
  EXTERNAL_CLICK
  WHATSAPP_CLICK
}

// Spec §21 — sub-order fulfillment lifecycle (per vendor).
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  FAILED
}

// Payment status on the parent (customer-facing) order.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// ---------------------------------------------------------------------------
// Phase 2 enums
// ---------------------------------------------------------------------------

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum FeaturedPlacement {
  HOMEPAGE
  CATEGORY
  SEARCH
  TRENDING
}

enum FeaturedStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  REPORTED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SupportConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}
