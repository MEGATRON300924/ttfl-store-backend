// TTFL Store — Database schema
// Phase 1 + Phase 2: identity, access, vendors, catalog, commerce,
// subscriptions, promotions, payouts, email delivery, support, and settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum AuditAction {
  ADMIN_LOGIN
  USER_SUSPENDED
  USER_REACTIVATED
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  VENDOR_TIER_CHANGED
  VENDOR_PROFILE_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  ACCOUNT_DELETED
  PRODUCT_SUSPENDED
  PRODUCT_REINSTATED
  PRODUCT_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  VENDOR_PLAN_CREATED
  VENDOR_PLAN_UPDATED
  SUBSCRIPTION_CHANGED
  FEATURED_PRODUCT_APPROVED
  FEATURED_PRODUCT_CANCELLED
  FEATURED_STORE_APPROVED
  FEATURED_STORE_CANCELLED
  REVIEW_HIDDEN
  REVIEW_DELETED
  COUPON_CREATED
  COUPON_UPDATED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
  ORDER_REFUNDED
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OUT_OF_STOCK
}

enum SellingMethod {
  CHECKOUT
  EXTERNAL_LINK
  WHATSAPP
}

enum ReferralType {
  EXTERNAL_CLICK
  WHATSAPP_CLICK
  PRODUCT_VIEW
}

// Spec §21 — sub-order fulfillment lifecycle (per vendor).
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  FAILED
}

// Payment status on the parent (customer-facing) order.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Preserve the remainder of the existing schema exactly as maintained by the
// backend schema-preparation scripts.
